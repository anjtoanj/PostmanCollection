		{
			"name": "Composite Delete",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let ids = JSON.parse(pm.environment.get(\"lead_ids\") || \"[]\");\r",
							"\r",
							"// Take first 25 IDs for this batch\r",
							"let batchIds = ids.splice(0, 20); \r",
							"pm.environment.set(\"lead_ids\", JSON.stringify(ids)); // remaining IDs\r",
							"\r",
							"let batchRequests = batchIds.map(id => ({\r",
							"    method: \"DELETE\",\r",
							"    url: `/services/data/v57.0/sobjects/Lead/${id}`\r",
							"}));\r",
							"\r",
							"if (batchRequests.length === 0) {\r",
							"    throw new Error(\"Batch requests array is empty! Cannot send to Salesforce.\");\r",
							"}\r",
							"\r",
							"// Set batch_body environment variable\r",
							"pm.environment.set(\"batch_body\", JSON.stringify({\r",
							"    batchRequests: batchRequests,\r",
							"    haltOnError: false\r",
							"}));\r",
							"\r",
							"console.log(\"Batch Requests Count:\", batchRequests.length);\r",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
