	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"const client_id = pm.environment.get(\"client_id\");\r",
					"const client_secret = pm.environment.get(\"client_secret\");\r",
					"const username = pm.environment.get(\"username\");\r",
					"const password = pm.environment.get(\"password\");\r",
					"const login_url = pm.environment.get(\"login_url\"); // e.g., https://login.salesforce.com/services/oauth2/token\r",
					"\r",
					"pm.sendRequest({\r",
					"    url: login_url,\r",
					"    method: 'POST',\r",
					"    header: {\r",
					"        'Content-Type': 'application/x-www-form-urlencoded'\r",
					"    },\r",
					"    body: {\r",
					"        mode: 'urlencoded',\r",
					"        urlencoded: [\r",
					"            {key: \"grant_type\", value: \"password\"},\r",
					"            {key: \"client_id\", value: client_id},\r",
					"            {key: \"client_secret\", value: client_secret},\r",
					"            {key: \"username\", value: username},\r",
					"            {key: \"password\", value: password}\r",
					"        ]\r",
					"    }\r",
					"}, function (err, res) {\r",
					"    if (err) {\r",
					"        console.log(\"Token request failed: \", err);\r",
					"    } else {\r",
					"        let jsonData = res.json();\r",
					"        pm.environment.set(\"access_token\", jsonData.access_token);\r",
					"    }\r",
					"});\r",
					""
				]
			}
